# Alpine-Maintainer: Ariadne Conill <ariadne@dereferenced.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=libucontext
pkgver=1.3.3
pkgrel=0
pkgdesc="ucontext function implementations"
url="https://github.com/kaniini/libucontext"
arch="all"
license="ISC"
subpackages="$pkgname-dev"
subpackages="$subpackages $pkgname-doc"
makedepends="scdoc"
source="https://distfiles.ariadne.space/libucontext/libucontext-$pkgver.tar.xz"
_make_config="FREESTANDING=yes ARCH=$CARCH"

build() {
    make $_make_config
    make $_make_config docs
}

check() {
    make $_make_config check
}

package() {
    make $_make_config DESTDIR="$pkgdir" install install_docs
}

